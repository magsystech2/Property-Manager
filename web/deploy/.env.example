# Supabase dashboard -> Project Settings -> API. Same values as the iPhone app.
# Leave both empty to run demo mode only.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Port on the LXC where the app listens (plain http, for your home network).
LEDGER_PORT=8080

# Recommended (no domain needed): Tailscale auth key (docker compose --profile tailscale up -d)
TS_AUTHKEY=
TS_HOSTNAME=ledger

# HTTPS option A: Cloudflare Tunnel token (docker compose --profile tunnel up -d)
TUNNEL_TOKEN=

# HTTPS option B: your domain for Caddy (docker compose --profile caddy up -d)
LEDGER_DOMAIN=
